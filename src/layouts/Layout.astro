---
export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Golf Almighty — Indoor Golf Simulators & Sports Bar. Two GTA locations in Brampton and Bolton. Open 24/7." } = Astro.props;

const nav = [
  { label: 'Rates', href: '/rates' },
  { label: 'Membership', href: '/membership' },
  { label: 'Gift Card', href: '/gift-card' },
  { label: 'Golf On The Go', href: '/golf-on-the-go' },
  { label: 'Club Rentals', href: '/club-rentals' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} – Golf Almighty</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="https://golfalmighty.ca/wp-content/uploads/2023/11/cropped-512-x-512-icon-270x270.png" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    :root {
      --green:       #2db84b;
      --green-dark:  #1f8f38;
      --green-light: #3fd45e;
      --green-bg:    rgba(45,184,75,0.08);
      --green-bd:    rgba(45,184,75,0.25);
      --navy:        #0d1117;
      --navy2:       #111827;
      --navy3:       #1a2332;
      --card-dark:   #161f2e;
      --white:       #ffffff;
      --off:         #f8f9fa;
      --off2:        #f3f4f6;
      --text:        #111827;
      --muted:       #6b7280;
      --border:      rgba(0,0,0,0.07);
      --border2:     rgba(0,0,0,0.12);
      --border-dark: rgba(255,255,255,0.08);
      --r:  10px;
      --rl: 16px;
      --rxl: 20px;
    }
    body { font-family:'Montserrat',sans-serif; background:var(--white); color:var(--text); overflow-x:hidden; -webkit-font-smoothing:antialiased; padding-top:68px; }
    .container { max-width:1100px; margin:0 auto; padding:0 28px; }
    .eyebrow { display:inline-flex; align-items:center; gap:7px; font-size:0.62rem; font-weight:800; letter-spacing:0.22em; text-transform:uppercase; color:var(--green); background:var(--green-bg); border:1px solid var(--green-bd); padding:6px 14px; border-radius:50px; margin-bottom:16px; }
    .eyebrow-dark { display:inline-flex; align-items:center; gap:7px; font-size:0.62rem; font-weight:800; letter-spacing:0.22em; text-transform:uppercase; color:var(--green); background:rgba(45,184,75,0.12); border:1px solid rgba(45,184,75,0.3); padding:6px 14px; border-radius:50px; margin-bottom:16px; }
    .section-title { font-size:clamp(1.9rem,4vw,3.2rem); font-weight:900; line-height:1.08; color:var(--text); letter-spacing:-0.025em; margin-bottom:14px; }
    .section-title span { color:var(--green); }
    .section-title-dark { color:#ffffff; }
    .section-title-dark span { color:var(--green); }
    .section-body { font-size:0.93rem; color:var(--muted); line-height:1.85; max-width:620px; }
    .section-body-dark { color:rgba(255,255,255,0.5); }
    .btn { display:inline-flex; align-items:center; gap:8px; font-family:'Montserrat',sans-serif; font-weight:800; font-size:0.78rem; letter-spacing:0.1em; text-transform:uppercase; padding:14px 28px; border-radius:50px; text-decoration:none; cursor:pointer; border:none; transition:all 0.22s; white-space:nowrap; }
    .btn-green { background:var(--green); color:#fff; box-shadow:0 4px 20px rgba(45,184,75,0.4); }
    .btn-green:hover { background:var(--green-light); transform:translateY(-2px); box-shadow:0 6px 28px rgba(45,184,75,0.5); }
    .btn-outline-white { background:transparent; color:#fff; border:1.5px solid rgba(255,255,255,0.3); }
    .btn-outline-white:hover { border-color:#fff; background:rgba(255,255,255,0.08); transform:translateY(-2px); }
    .btn-outline-green { background:transparent; color:var(--green); border:1.5px solid var(--green); }
    .btn-outline-green:hover { background:var(--green-bg); transform:translateY(-2px); }
    .reveal { opacity:0; transform:translateY(24px); transition:opacity 0.6s ease,transform 0.6s ease; }
    .reveal.visible { opacity:1; transform:translateY(0); }

    /* NAV */
    .ga-nav { position:fixed; top:0; left:0; right:0; z-index:9999; padding:0 32px; display:flex; align-items:center; justify-content:space-between; height:68px; transition:background 0.3s,backdrop-filter 0.3s,box-shadow 0.3s; }
    .ga-nav.scrolled { background:rgba(13,17,23,0.95); backdrop-filter:blur(20px); box-shadow:0 1px 0 rgba(255,255,255,0.06); }
    .ga-nav-logo img { height:40px; display:block; }
    .ga-nav-links { display:flex; align-items:center; gap:24px; list-style:none; }
    .ga-nav-links a { font-size:0.7rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:rgba(255,255,255,0.7); text-decoration:none; transition:color 0.2s; }
    .ga-nav-links a:hover,.ga-nav-links a.active { color:var(--green); }
    .ga-nav-cta { display:flex; gap:10px; align-items:center; }
    .ga-nav-cta a { font-family:'Montserrat',sans-serif; font-size:0.68rem; font-weight:800; letter-spacing:0.1em; text-transform:uppercase; padding:9px 18px; border-radius:50px; text-decoration:none; transition:all 0.22s; display:inline-block; }
    .ga-btn-green { background:var(--green); color:#fff; box-shadow:0 4px 14px rgba(45,184,75,0.4); }
    .ga-btn-green:hover { background:var(--green-light); transform:translateY(-1px); }
    .ga-btn-outline { background:transparent; color:#fff; border:1.5px solid rgba(255,255,255,0.3); }
    .ga-btn-outline:hover { border-color:#fff; background:rgba(255,255,255,0.06); }
    .ga-burger { display:none; flex-direction:column; gap:5px; background:none; border:none; cursor:pointer; padding:4px; z-index:10001; }
    .ga-burger span { width:24px; height:2px; background:#fff; border-radius:2px; transition:all 0.25s; display:block; }
    .ga-burger.open span:nth-child(1) { transform:translateY(7px) rotate(45deg); }
    .ga-burger.open span:nth-child(2) { opacity:0; }
    .ga-burger.open span:nth-child(3) { transform:translateY(-7px) rotate(-45deg); }
    .ga-mobile-menu { display:none; position:fixed; top:68px; left:0; right:0; z-index:9998; background:rgba(13,17,23,0.98); backdrop-filter:blur(20px); padding:24px 28px 32px; flex-direction:column; border-top:1px solid rgba(255,255,255,0.06); }
    .ga-mobile-menu.open { display:flex; }
    .ga-mobile-menu a { font-family:'Montserrat',sans-serif; font-size:1rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:rgba(255,255,255,0.8); text-decoration:none; padding:16px 0; border-bottom:1px solid rgba(255,255,255,0.06); transition:color 0.2s; }
    .ga-mobile-menu a:hover,.ga-mobile-menu a.active { color:var(--green); }
    .ga-mobile-btns { display:flex; gap:10px; margin-top:24px; flex-wrap:wrap; }
    .ga-mobile-btns a { font-family:'Montserrat',sans-serif; font-weight:800; font-size:0.72rem; letter-spacing:0.1em; text-transform:uppercase; padding:12px 20px; border-radius:50px; text-decoration:none; transition:all 0.22s; border-bottom:none !important; }

    /* FOOTER */
    .ga-footer { background:var(--navy); padding:64px 28px 32px; }
    .ga-footer-inner { max-width:1100px; margin:0 auto; display:grid; grid-template-columns:1.8fr 1fr 1fr 1.3fr; gap:48px; padding-bottom:48px; border-bottom:1px solid rgba(255,255,255,0.07); }
    .ga-footer-logo { height:42px; margin-bottom:18px; display:block; }
    .ga-footer-tagline { font-size:0.82rem; color:rgba(255,255,255,0.3); line-height:1.75; max-width:240px; }
    .ga-footer-col h4 { font-size:0.6rem; font-weight:800; letter-spacing:0.24em; text-transform:uppercase; color:var(--green); margin-bottom:18px; }
    .ga-footer-col ul { list-style:none; display:flex; flex-direction:column; gap:10px; }
    .ga-footer-col ul li a { font-size:0.82rem; color:rgba(255,255,255,0.4); text-decoration:none; transition:color 0.2s; }
    .ga-footer-col ul li a:hover { color:var(--green); }
    .ga-footer-col p { font-size:0.82rem; color:rgba(255,255,255,0.4); line-height:1.7; }
    .ga-footer-col p a { color:rgba(255,255,255,0.4); text-decoration:none; transition:color 0.2s; }
    .ga-footer-col p a:hover { color:var(--green); }
    .ga-footer-bottom { max-width:1100px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; padding-top:28px; gap:16px; flex-wrap:wrap; }
    .ga-footer-copy { font-size:0.7rem; color:rgba(255,255,255,0.18); }
    .ga-footer-social { display:flex; gap:10px; }
    .ga-footer-social a { width:36px; height:36px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07); border-radius:50%; display:flex; align-items:center; justify-content:center; text-decoration:none; transition:all 0.2s; }
    .ga-footer-social a:hover { background:var(--green); border-color:var(--green); }
    .ga-footer-social svg { width:14px; height:14px; stroke:rgba(255,255,255,0.5); fill:none; }
    .ga-footer-social a:hover svg { stroke:#fff; }

    @media(max-width:960px){.ga-nav-links,.ga-nav-cta{display:none}.ga-burger{display:flex}.ga-footer-inner{grid-template-columns:1fr 1fr;gap:36px}}
    @media(max-width:560px){.ga-footer-inner{grid-template-columns:1fr}}
  </style>
</head>
<body>

<nav class="ga-nav" id="ga-nav">
  <a href="/" class="ga-nav-logo">
    <img src="https://golfalmighty.ca/wp-content/uploads/2023/11/Golf-Almighty-Logo-1.png" alt="Golf Almighty" />
  </a>
  <ul class="ga-nav-links">
    {nav.map(item => (
      <li><a href={item.href} class={Astro.url.pathname === item.href ? 'active' : ''}>{item.label}</a></li>
    ))}
  </ul>
  <div class="ga-nav-cta">
    <a href="https://albaplay.com/en/venue/golf-almighty-brampton" class="ga-btn-outline">Brampton</a>
    <a href="https://albaplay.com/en/venue/golf-almighty-bolton" class="ga-btn-green">Bolton</a>
  </div>
  <button class="ga-burger" id="ga-burger" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>

<div class="ga-mobile-menu" id="ga-mobile-menu">
  {nav.map(item => (
    <a href={item.href} class={Astro.url.pathname === item.href ? 'active' : ''}>{item.label}</a>
  ))}
  <div class="ga-mobile-btns">
    <a href="https://albaplay.com/en/venue/golf-almighty-brampton" style="border:1.5px solid rgba(255,255,255,0.3);color:#fff;">Book Brampton</a>
    <a href="https://albaplay.com/en/venue/golf-almighty-bolton" class="ga-btn-green">Book Bolton</a>
  </div>
</div>

<slot />

<footer class="ga-footer">
  <div class="ga-footer-inner">
    <div>
      <img src="https://golfalmighty.ca/wp-content/uploads/2023/11/Golf-Almighty-Logo-1.png" alt="Golf Almighty" class="ga-footer-logo" />
      <p class="ga-footer-tagline">The premier indoor golf simulator destination in the GTA. Two locations. Open 24/7.</p>
    </div>
    <div class="ga-footer-col">
      <h4>Explore</h4>
      <ul>{nav.map(item => <li><a href={item.href}>{item.label}</a></li>)}</ul>
    </div>
    <div class="ga-footer-col">
      <h4>Hours</h4>
      <p>Simulators: Open 24/7<br /><br />Bar — Mon–Thu: 6pm–10:30pm<br />Fri: 5pm–12:30am<br />Sat: 2pm–12:30am<br />Sun: 2pm–10:30pm</p>
    </div>
    <div class="ga-footer-col">
      <h4>Contact</h4>
      <p>📍 3 Chapel St, Brampton ON<br />📍 18 King St E, Bolton ON<br /><br />📞 <a href="tel:14162164135">1-416-216-4135</a><br />✉️ <a href="mailto:hello@golfalmighty.ca">hello@golfalmighty.ca</a></p>
    </div>
  </div>
  <div class="ga-footer-bottom">
    <p class="ga-footer-copy">© 2026 Golf Almighty. All rights reserved.</p>
    <div class="ga-footer-social">
      <a href="https://www.instagram.com/realgolfalmighty/" target="_blank" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>
      <a href="https://www.youtube.com/@golfalmighty" target="_blank" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg></a>
      <a href="https://www.facebook.com/golfalmighty" target="_blank" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
    </div>
  </div>
</footer>

<script>
  const nav = document.getElementById('ga-nav');
  window.addEventListener('scroll', () => nav?.classList.toggle('scrolled', window.scrollY > 40));
  const burger = document.getElementById('ga-burger');
  const mobileMenu = document.getElementById('ga-mobile-menu');
  burger?.addEventListener('click', () => { burger.classList.toggle('open'); mobileMenu?.classList.toggle('open'); });
  mobileMenu?.querySelectorAll('a').forEach(l => l.addEventListener('click', () => { burger?.classList.remove('open'); mobileMenu?.classList.remove('open'); }));
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
  }, { threshold: 0.07 });
  document.querySelectorAll('.reveal').forEach((el, i) => { (el as HTMLElement).style.transitionDelay = (i % 5) * 0.06 + 's'; obs.observe(el); });
</script>
</body>
</html>
